# Reference for the variables docker-compose.yml reads.
# Don't copy this by hand: run `make setup`, which generates .env with real secrets.

SALEOR_VERSION=3.23

POSTGRES_PASSWORD=
SALEOR_DB_PASSWORD=
STOREBRIDGE_DB_PASSWORD=

# Django secret key for Saleor.
SALEOR_SECRET_KEY=

# PEM-encoded RSA private key, in double quotes, used by Saleor to sign JWTs.
SALEOR_RSA_PRIVATE_KEY=
